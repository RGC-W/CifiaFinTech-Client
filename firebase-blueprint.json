{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile and branch/portal preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "branchName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "defaultCurrency": {
          "type": "string",
          "enum": ["USD", "KES", "NGN", "GHS", "EUR", "GBP"]
        },
        "alertThresholdCents": {
          "type": "integer",
          "description": "Single-transaction amount threshold in cents (0 disables dashboard warnings)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "branchName",
        "defaultCurrency",
        "createdAt",
        "updatedAt"
      ]
    },
    "Customer": {
      "title": "Customer",
      "description": "Microfinance customer KYC profile managed by an authenticated branch officer.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
