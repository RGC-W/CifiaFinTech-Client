          "enum": ["sent", "queued_in_app", "failed"]
        },
        "deliveryChannel": {
          "type": "string",
          "maxLength": 32
        },
        "deliveryNote": {
          "type": "string",
          "maxLength": 240
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "recipientEmail",
        "accountId",
        "accountNumber",
        "customerName",
        "operationType",
        "outcome",
        "details",
        "deliveryStatus",
        "createdByUid",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile containing PII and branch/portal preferences."
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Customer KYC directory records accessible to the managing officer or linked verified customer."
    },
    "/accounts/{accountId}": {
      "schema": { "$ref": "#/entities/Account" },
      "description": "Microfinance savings/business/solidarity accounts opened in the main app."
    },
    "/accountDirectory/{accountNumber}": {
      "schema": { "$ref": "#/entities/AccountDirectoryEntry" },
      "description": "Non-PII exact-match lookup entries for account enrollment and transfers."
    },
    "/clientAccess/{accountNumber}": {
      "schema": { "$ref": "#/entities/ClientAccess" },
      "description": "Salted PBKDF2 password credentials for customer self-service login by Main App account ID."
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Deposit, withdrawal, and transfer ledger entries for customer accounts."
    },
    "/staffUsers/{staffId}": {
      "schema": { "$ref": "#/entities/StaffUser" },
      "description": "Branch staff accounts (strictly 1 Admin + unlimited User Cat 1 tellers)."
    },
    "/approvalRequests/{requestId}": {
      "schema": { "$ref": "#/entities/ApprovalRequest" },
      "description": "Validation request messages for over-$350 withdrawals, operation deletions, client access activation, and client withdrawal confirmations."
    },
    "/dailyReports/{reportId}": {
      "schema": { "$ref": "#/entities/DailyCashReport" },
      "description": "Daily teller cash reconciliation reports (starting cash minus cash withdrawals plus deposits)."
    },
    "/emailNotifications/{notificationId}": {
      "schema": { "$ref": "#/entities/EmailNotification" },
      "description": "Customer email notifications and dispatch statuses for account operations."
    }
  }
}
